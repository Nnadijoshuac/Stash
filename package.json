{
  "name": "stash",
  "version": "0.1.0",
  "private": true,
  "description": "Get paid in dollars. Keep some of it in stocks. A basket of xStocks per payment, in one Solana transaction.",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "basket-size": "pnpm --filter @stash/scripts basket-size",
    "fund": "pnpm --filter @stash/scripts fund"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
