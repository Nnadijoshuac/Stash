  "description": "Stash on Android: set your rule, get told when you are paid, stash the slice. Solana devnet.",
  "main": "./index.js",
  "version": "1.0.0",
  "scripts": {
    "android": "expo run:android",
    "android:build": "expo prebuild -p android",
